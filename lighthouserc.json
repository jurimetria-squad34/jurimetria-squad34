{
    "ci": {
        "collect": {
            "startServerCommand": "npm --prefix site run preview",
            "startServerReadyPattern": "Local",
            "startServerReadyTimeout": 30000,
            "url": [
                "http://localhost:4321/",
                "http://localhost:4321/como-funciona",
                "http://localhost:4321/planos",
                "http://localhost:4321/pedir-acesso",
                "http://localhost:4321/conteudo",
                "http://localhost:4321/conteudo/o-que-e-jurimetria",
                "http://localhost:4321/conteudo/taxa-hc-stj",
                "http://localhost:4321/conteudo/pesquisar-jurisprudencia-prisao-preventiva",
                "http://localhost:4321/conteudo/o-que-e-precedente-vinculante",
                "http://localhost:4321/conteudo/taxa-provimento-resp-stj",
                "http://localhost:4321/conteudo/jurimetria-na-estrategia",
                "http://localhost:4321/privacidade",
                "http://localhost:4321/termos"
            ],
            "numberOfRuns": 1,
            "settings": {
                "preset": "desktop",
                "onlyCategories": [
                    "performance",
                    "accessibility",
                    "best-practices",
                    "seo"
                ]
            }
        },
        "assert": {
            "assertions": {
                "categories:performance": [
                    "error",
                    {
                        "minScore": 0.9
                    }
                ],
                "categories:accessibility": [
                    "error",
                    {
                        "minScore": 0.9
                    }
                ],
                "categories:seo": [
                    "error",
                    {
                        "minScore": 0.9
                    }
                ],
                "categories:best-practices": [
                    "warn",
                    {
                        "minScore": 0.8
                    }
                ]
            }
        },
        "upload": {
            "target": "temporary-public-storage"
        }
    }
}