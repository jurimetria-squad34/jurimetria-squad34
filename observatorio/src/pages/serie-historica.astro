---
import Base from "../layouts/Base.astro";
import SerieHistorica from "../components/SerieHistorica";
---

<Base
  title="Série histórica — Observatório Jurimétrico do STJ e STF"
  description="Taxa favorável e volume de decisões por mês, filtrando por tribunal, classe e matéria."
>
  <h1 class="font-titulo text-3xl font-semibold text-toga md:text-4xl">Série histórica</h1>
  <p class="mt-3 max-w-prose text-tinta/80">
    Escolha um tribunal, uma classe e uma matéria para ver como a taxa de decisões favoráveis e o volume de
    decisões mudaram mês a mês.
  </p>

  <div class="mt-8">
    <SerieHistorica client:load />
  </div>
</Base>