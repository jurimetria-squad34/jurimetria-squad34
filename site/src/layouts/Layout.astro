---
// ============================================
// Imports
// ============================================
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// ============================================
// Tipos
// ============================================
interface Props {
    title: string;
    description?: string;
    image?: string;
    schema?: object;
}

// ============================================
// Props
// ============================================
const {
    title,
    description = 'Jurimetria — jurisprudência verificável do STJ e do STF.',
    image = '/og-image.png',
    schema,
} = Astro.props;

// ============================================
// URL canônica
// ============================================
const url = new URL(Astro.url.pathname, Astro.site);
const imagemAbsoluta = new URL(image, Astro.site);

// ============================================
// Schema.org — fallback quando a página não passa um
// ============================================
const schemaFinal = schema ?? {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: url.href,
    inLanguage: 'pt-BR',
    isPartOf: { '@type': 'WebSite', name: 'Jurimetria', url: Astro.site?.href },
};
const schemaJson = JSON.stringify(schemaFinal).replace(/</g, '\\u003c');
---

---
<!doctype html>
<html lang="pt-BR">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />

        {/* ============================================
            Fontes — carregamento sem bloqueio
            ============================================ */}

        {/* ============================================
            SEO
            ============================================ */}
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={url} />

        {/* ============================================
            Open Graph
            ============================================ */}
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={url} />
        <meta property="og:image" content={imagemAbsoluta} />
        <meta property="og:locale" content="pt_BR" />
        <meta property="og:site_name" content="Jurimetria" />

        {/* ============================================
            Twitter Card
            ============================================ */}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={imagemAbsoluta} />

        {/* ============================================
            Schema.org
            ============================================ */}
        <script type="application/ld+json" set:html={schemaJson} />
    </head>
    <body>
        {/* Skip link */}
        <a
            href="#conteudo"
            class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:bg-verde focus:text-white focus:px-4 focus:py-2 focus:z-50 focus:rounded"
        >
            Pular para o conteúdo
        </a>

        <Header />

        <main id="conteudo">
            <slot />
        </main>

        <Footer />
    </body>
</html>
