---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
    const conteudos = await getCollection('conteudo');
    return conteudos.map((item) => ({
        params: { slug: item.id },
        props: { item },
    }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<Layout
    title={`${item.data.titulo} — Jurimetria`}
    description={item.data.descricao}
>
    <div class="bg-papel text-tinta font-corpo">
        <article class="max-w-3xl mx-auto px-6 py-20">
            <header class="mb-12">
                <p class="text-sm text-tinta-suave uppercase tracking-wider mb-3">
                    {item.data.categoria}
                </p>
                <h1 class="font-titulo text-4xl md:text-5xl font-bold leading-tight mb-6">
                    {item.data.titulo}
                </h1>
                <p class="text-tinta-suave">
                    Atualizado em {item.data.atualizado}
                </p>
            </header>

            <div class="prosa">
                <Content />
            </div>

            <aside class="mt-16 pt-8 border-t border-borda">
                <h2 class="font-titulo text-2xl font-semibold mb-3">
                    Peça acesso ao Jurimetria.
                </h2>
                <p class="text-tinta-suave mb-6">
                    Veja os números do STJ e do STF com universo, período e
                    critério, e cada decisão com trecho literal e link oficial.
                </p>
                <a
                    href="/pedir-acesso"
                    class="inline-block bg-verde text-white font-semibold no-underline py-3 px-6 rounded transition-colors hover:bg-verde-claro"
                >
                    Pedir acesso
                </a>
            </aside>

            <p class="mt-12">
                <a
                    href="/conteudo"
                    class="text-verde font-semibold no-underline hover:underline"
                >
                    ← Voltar para o índice
                </a>
            </p>
        </article>
    </div>
</Layout>

<style>
    .prosa {
        font-size: 1.0625rem;
        line-height: 1.7;
        color: var(--color-tinta);
    }

    .prosa :global(h2) {
        font-family: var(--font-titulo);
        font-size: 1.6rem;
        font-weight: 600;
        line-height: 1.25;
        color: var(--color-tinta);
        margin-top: 2.5rem;
        margin-bottom: 1rem;
    }

    .prosa :global(p) {
        margin: 0 0 1rem;
    }

    .prosa :global(ul),
    .prosa :global(ol) {
        list-style: none;
        padding: 0;
        margin: 0 0 1.25rem;
    }

    .prosa :global(li) {
        position: relative;
        padding-left: 1.5rem;
        margin-bottom: 0.5rem;
    }

    .prosa :global(ul) > :global(li)::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0.7em;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--color-verde);
    }

    .prosa :global(a) {
        color: var(--color-verde);
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-thickness: 1px;
    }

    .prosa :global(a:hover) {
        color: var(--color-verde-claro);
    }

    .prosa :global(strong) {
        font-weight: 600;
    }
</style>
