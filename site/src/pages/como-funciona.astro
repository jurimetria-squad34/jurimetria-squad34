---
// ============================================
// Imports
// ============================================
import Layout from '../layouts/Layout.astro';
import universo from '../data/universo.json';
import TelaHero from '../components/como-funciona/TelaHero.astro';
import DemoPesquisa from '../components/como-funciona/DemoPesquisa.astro';

// ============================================
const { tribunais, decisoes, de, ate } = universo.universo;
const total = decisoes.toLocaleString('pt-BR');
const listaTribunais = new Intl.ListFormat('pt-BR', {
    style: 'long',
    type: 'conjunction',
}).format(tribunais);

// Passos da pesquisa por caso
// ============================================
const passos = [
    {
        id: 'caso',
        titulo: 'Descreva o caso',
        texto: 'O advogado cola os fatos ou a petição inteira. Pode ser um parágrafo ou várias páginas, em linguagem comum.',
    },
    {
        id: 'plano',
        titulo: 'Revise o plano de busca',
        texto: 'O sistema mostra o que vai procurar: as teses identificadas, as classes mais prováveis e os filtros aplicados. O advogado revisa e ajusta antes de buscar.',
    },
    {
        id: 'precedentes',
        titulo: 'Veja os precedentes',
        texto: 'A busca devolve três blocos: decisões favoráveis, contrárias e de distinção. Cada uma vem com o trecho literal que a sustenta e o link para o tribunal.',
    },
    {
        id: 'trecho',
        titulo: 'Confira o trecho e o link',
        texto: 'O trecho aparece idêntico ao inteiro teor, com os termos destacados. O link abre o documento oficial no site do STJ ou do STF.',
    },
    {
        id: 'decisao',
        titulo: 'Decida com a fonte',
        texto: 'O advogado lê a decisão completa, com o número do processo e a data de publicação à vista, e decide como usar na tese.',
    },
];

// ============================================
// Regras da base
// ============================================
const regras = [
    'Decisão que não está na base não aparece.',
    'Decisão sem link oficial não entra.',
    'Trecho que não casa com o texto original é descartado.',
];

// ============================================
// Limites do produto
// ============================================
const limites = [
    {
        titulo: 'Não gera petição',
        texto: 'O produto entrega os precedentes e o trecho literal. A peça é escrita pelo advogado.',
    },
    {
        titulo: 'Não prevê o resultado',
        texto: 'O sistema mostra como casos parecidos foram decididos. A decisão do processo é do juiz.',
    },
    {
        titulo: 'Não busca por nome de parte',
        texto: 'A base não tem nome de parte, e o produto não procura por esse dado em nenhum lugar.',
    },
];
---

<Layout
    title="Como funciona — Jurimetria"
    description="O passo a passo da pesquisa por caso no Jurimetria, com trecho literal e link oficial em cada precedente."
>
    <div class="cf">
        {/* ============================================
            Hero — texto + exemplo de decisão
            ============================================ */}
        <section class="hero">
            <div class="container-site hero-grid">
                <div>
                    <h1>Precedentes que você confere na fonte.</h1>
                    <p class="lead">
                        Descreva o caso em linguagem comum. O Jurimetria busca
                        no STJ e no STF e separa o que ajuda, o que atrapalha e
                        o que distingue. Cada decisão vem com o trecho literal e
                        o link oficial.
                    </p>
                    <div class="acoes">
                        <a href="/pedir-acesso" class="btn">Pedir acesso</a>
                        <a href="#passos" class="link">Ver os passos</a>
                    </div>
                </div>

                <TelaHero />
            </div>
        </section>

        {/* ============================================
            Fatos
            ============================================ */}
        <section class="fatos">
            <div class="container-site fatos-grid">
                <p><strong>{total}</strong> de decisões</p>
                <p><strong>STJ e STF</strong> na mesma busca</p>
                <p><strong>Trecho literal</strong> e link oficial em cada uma</p>
            </div>
            <p class="container-site legenda-base">
                Base: {total} decisões do {listaTribunais}, de {de} a {ate}.{' '}
                {universo.criterio}
            </p>
        </section>

        {/* ============================================
            Passos
            ============================================ */}
        <section class="passos" id="passos">
            <div class="container-site">
                <h2>Do caso ao precedente, em cinco passos</h2>

                <p class="passos-intro">
                    Teste a pesquisa por caso aqui mesmo: edite o texto, avance
                    pelos passos e clique nos resultados.
                </p>

                <DemoPesquisa />
            </div>
        </section>

        {/* ============================================
            Regra de ouro
            ============================================ */}
        <section class="regra">
            <div class="container-site regra-grid">
                <p class="regra-texto">
                    Tudo o que aparece vem da base, com trecho literal e link
                    oficial. Nada é inventado pela IA.
                </p>
                <ul class="regra-lista">
                    {regras.map((r) => (
                        <li>{r}</li>
                    ))}
                </ul>
            </div>
        </section>

        {/* ============================================
            Limites
            ============================================ */}
        <section class="limites">
            <div class="container-site">
                <h2>O que a pesquisa por caso não faz</h2>
                <dl class="limites-lista">
                    {limites.map((l) => (
                        <div class="limite">
                            <dt>{l.titulo}</dt>
                            <dd>{l.texto}</dd>
                        </div>
                    ))}
                </dl>
            </div>
        </section>

        {/* ============================================
            CTA final
            ============================================ */}
        <section class="cta">
            <div class="container-site cta-grid">
                <div>
                    <h2>Peça acesso e faça uma pesquisa por caso.</h2>
                    <p>
                        Veja os precedentes do seu caso, cada um com a fonte
                        oficial.
                    </p>
                </div>
                <a href="/pedir-acesso" class="btn btn-claro">
                    Pedir acesso
                </a>
            </div>
        </section>
    </div>
</Layout>

<style>
    /* ============================================
       Escopo da página — usa variáveis do global.css
       ============================================ */
    .cf {
        background: var(--color-papel);
        color: var(--color-tinta);
        font-family: var(--font-corpo);
        font-size: 1.0625rem;
        line-height: 1.6;
    }

    .cf h1,
    .cf h2,
    .cf h3 {
        font-family: var(--font-titulo);
        color: inherit;
        margin: 0;
        letter-spacing: -0.01em;
    }

    .cf h1 {
        font-size: clamp(2.3rem, 5vw, 3.7rem);
        font-weight: 700;
        line-height: 1.04;
        margin-bottom: 1.5rem;
    }

    .cf h2 {
        font-size: clamp(1.6rem, 3vw, 2.2rem);
        font-weight: 600;
        line-height: 1.15;
    }

    .cf h3 {
        font-size: 1.4rem;
        font-weight: 600;
        line-height: 1.25;
        margin-bottom: 0.5rem;
    }

    .cf p,
    .cf ul,
    .cf ol,
    .cf dl,
    .cf dd,
    .cf figure {
        margin: 0;
    }

    .cf ul,
    .cf ol {
        list-style: none;
        padding: 0;
    }

    .cf .lead {
        font-size: 1.15rem;
        color: var(--color-tinta);
        max-width: 34rem;
        margin-bottom: 2rem;
    }

    /* ============================================
       Ações e botões
       ============================================ */
    .cf .acoes {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1.5rem;
    }

    .cf .btn {
        display: inline-block;
        background: var(--color-verde);
        color: #ffffff;
        font-weight: 600;
        text-decoration: none;
        padding: 0.85rem 1.6rem;
        border-radius: 4px;
        transition: background-color 0.15s ease;
    }

    .cf .btn:hover {
        background: var(--color-verde-claro);
    }

    .cf .btn-claro {
        background: var(--color-ouro);
        color: var(--color-tinta);
    }

    .cf .btn-claro:hover {
        background: var(--color-ouro-claro);
    }

    .cf .link {
        color: var(--color-tinta);
        font-weight: 500;
        text-decoration: underline;
        text-underline-offset: 0.3em;
        text-decoration-thickness: 1px;
    }

    .cf .link:hover {
        color: var(--color-verde);
    }

    .cf .btn:focus-visible,
    .cf .link:focus-visible {
        outline: 3px solid var(--color-mostarda);
        outline-offset: 3px;
    }

    .cf .cta .btn:focus-visible {
        outline-color: #ffffff;
    }

    /* ============================================
       Hero
       ============================================ */
    .cf .hero {
        padding: 3rem 0 3rem;
    }

    .cf .hero-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 3.5rem;
        align-items: center;
    }

    /* ============================================
       Fatos
       ============================================ */
    .cf .fatos {
        border-top: 1px solid var(--color-borda);
        border-bottom: 1px solid var(--color-borda);
        background: #ffffff;
    }

    .cf .fatos-grid {
        display: grid;
        grid-template-columns: 1fr;
    }

    .cf .fatos p {
        padding: 1.1rem 0;
        color: var(--color-tinta-suave);
        border-top: 1px solid var(--color-borda);
    }

    .cf .fatos p:first-child {
        border-top: none;
    }

    .cf .fatos strong {
        color: var(--color-tinta);
        font-family: var(--font-titulo);
        font-size: 1.3rem;
        font-weight: 700;
    }

    /* ============================================
       Passos
       ============================================ */
    .cf .passos {
        padding: 3.5rem 0 3.5rem;
    }

    .cf .lista-passos {
        margin-top: 2.5rem;
    }

    .cf .passo {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.75rem;
        padding: 2.75rem 0;
        border-top: 1px solid var(--color-borda);
        align-items: center;
    }

    .cf .passo-n {
        display: block;
        font-family: var(--font-titulo);
        font-size: 3.2rem;
        font-weight: 700;
        line-height: 1;
        color: var(--color-verde);
        margin-bottom: 0.75rem;
    }

    .cf .passo-texto p {
        color: var(--color-tinta);
        max-width: 30rem;
    }

    .cf .passos-intro {
        margin-top: 0.75rem;
        color: var(--color-tinta-suave);
        max-width: 36rem;
    }

    /* ============================================
       Regra de ouro
       ============================================ */
    .cf .regra {
        border-top: 3px solid var(--color-ouro);
        background: var(--color-tinta);
        color: var(--color-papel);
        padding: 4.5rem 0;
    }

    .cf .regra-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2.5rem;
        align-items: center;
    }

    .cf .regra-texto {
        font-family: var(--font-titulo);
        font-size: clamp(1.6rem, 3.4vw, 2.4rem);
        color: var(--color-papel);
        font-weight: 600;
        line-height: 1.2;
        letter-spacing: -0.01em;
    }

    .cf .regra-lista {
        color: #c7d2ce;
    }

    .cf .regra-lista li {
        padding: 0.9rem 0;
        border-top: 1px solid rgba(238, 242, 240, 0.15);
    }

    .cf .regra-lista li:last-child {
        border-bottom: 1px solid rgba(238, 242, 240, 0.15);
    }

    /* ============================================
       Limites
       ============================================ */
    .cf .limites {
        padding: 3.5rem 0 3.5rem;
    }

    .cf .limites-lista {
        margin-top: 2rem;
    }

    .cf .limite {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.25rem 2rem;
        padding: 1.25rem 0;
        border-top: 1px solid var(--color-borda);
    }

    .cf .limite:last-child {
        border-bottom: 1px solid var(--color-borda);
    }

    .cf .limite dt {
        font-family: var(--font-titulo);
        font-size: 1.3rem;
        font-weight: 600;
        line-height: 1.25;
    }

    .cf .limite dd {
        color: var(--color-tinta);
    }

    /* ============================================
       CTA final
       ============================================ */
    .cf .cta {
        border-top: 4px solid var(--color-ouro);
        background: var(--color-verde);
        color: #ffffff;
        padding: 4.5rem 0;
    }

    .cf .cta-grid {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 2rem;
    }

    .cf .cta h2 {
        max-width: 30rem;
        margin-bottom: 0.75rem;
    }

    .cf .cta p {
        color: rgba(255, 255, 255, 0.8);
        max-width: 30rem;
    }

    /* ============================================
       Telas maiores
       ============================================ */
    @media (min-width: 48rem) {
        .cf .fatos-grid {
            grid-template-columns: repeat(3, 1fr);
        }

        .cf .fatos p {
            border-top: none;
            border-left: 1px solid var(--color-borda);
            padding: 1.4rem 1.5rem;
        }

        .cf .fatos p:first-child {
            border-left: none;
            padding-left: 0;
        }

        .cf .limite {
            grid-template-columns: 5fr 7fr;
            align-items: baseline;
        }

        .cf .cta-grid {
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
            gap: 3rem;
        }
    }

    @media (min-width: 64rem) {
        .cf .hero {
            padding: 4.5rem 0 4rem;
        }

        .cf .passos,
        .cf .limites {
            padding: 5rem 0 4.5rem;
        }

        .cf .hero-grid {
            grid-template-columns: 6fr 5fr;
            gap: 5rem;
        }

        .cf .passo {
            grid-template-columns: 5fr 6fr;
            gap: 5rem;
            padding: 3.5rem 0;
        }

        .cf .passo:nth-child(even) .passo-texto {
            order: 2;
        }

        .cf .regra-grid {
            grid-template-columns: 6fr 5fr;
            gap: 5rem;
        }
    }
    .cf .fatos p {
        text-align: center;
    }

    .cf .fatos .legenda-base {
        border: none;
        padding: 0 1.5rem 1.25rem;
        font-size: 0.85rem;
        max-width: 70rem;
        margin-inline: auto;
    }

    @media (min-width: 48rem) {
        .cf .fatos p:first-child {
            padding-left: 1.5rem;
        }
    }
</style>
