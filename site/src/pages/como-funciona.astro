---
// ============================================
// Imports
// ============================================
import exemplo from '../data/exemplo.json';
import Layout from '../layouts/Layout.astro';

// ============================================
// Passos da pesquisa por caso
// ============================================
const passos = [
    {
        id: 'caso',
        titulo: 'Descreva o caso',
        texto: 'O advogado cola os fatos ou a petição inteira. Pode ser um parágrafo ou várias páginas, em linguagem comum.',
    },
    {
        id: 'plano',
        titulo: 'Revise o plano de busca',
        texto: 'O sistema mostra o que vai procurar: as teses identificadas, as classes mais prováveis e os filtros aplicados. O advogado revisa e ajusta antes de buscar.',
    },
    {
        id: 'precedentes',
        titulo: 'Veja os precedentes',
        texto: 'A busca devolve três blocos: decisões favoráveis, contrárias e de distinção. Cada uma vem com o trecho literal que a sustenta e o link para o tribunal.',
    },
    {
        id: 'trecho',
        titulo: 'Confira o trecho e o link',
        texto: 'O trecho aparece idêntico ao inteiro teor, com os termos destacados. O link abre o documento oficial no site do STJ ou do STF.',
    },
    {
        id: 'decisao',
        titulo: 'Decida com a fonte',
        texto: 'O advogado lê a decisão completa, com o número do processo e a data de publicação à vista, e decide como usar na tese.',
    },
];

// ============================================
// Regras da base
// ============================================
const regras = [
    'Decisão que não está na base não aparece.',
    'Decisão sem link oficial não entra.',
    'Trecho que não casa com o texto original é descartado.',
];

// ============================================
// Limites do produto
// ============================================
const limites = [
    {
        titulo: 'Não gera petição',
        texto: 'O produto entrega os precedentes e o trecho literal. A peça é escrita pelo advogado.',
    },
    {
        titulo: 'Não prevê o resultado',
        texto: 'O sistema mostra como casos parecidos foram decididos. A decisão do processo é do juiz.',
    },
    {
        titulo: 'Não busca por nome de parte',
        texto: 'A base não tem nome de parte, e o produto não procura por esse dado em nenhum lugar.',
    },
];
---

<Layout
    title="Como funciona — Jurimetria"
    description="O passo a passo da pesquisa por caso no Jurimetria, com trecho literal e link oficial em cada precedente."
>
    <div class="cf">
        {/* ============================================
            Hero — texto + exemplo de decisão
            ============================================ */}
        <section class="hero">
            <div class="wrap hero-grid">
                <div>
                    <h1>Precedentes que você confere na fonte.</h1>
                    <p class="lead">
                        Descreva o caso em linguagem comum. O Jurimetria busca
                        no STJ e no STF e separa o que ajuda, o que atrapalha e
                        o que distingue. Cada decisão vem com o trecho literal e
                        o link oficial.
                    </p>
                    <div class="acoes">
                        <a href="/pedir-acesso" class="btn">
                            Pedir acesso
                        </a>
                        <a href="#passos" class="link">
                            Ver os passos
                        </a>
                    </div>
                </div>

                <figure class="tela" aria-label="Exemplo de pesquisa por caso">
                    <div class="tela-topo">Pesquisa por caso</div>
                    <div class="tela-corpo">
                        <dl class="plano">
                            <div>
                                <dt>Processo</dt>
                                <dd>
                                    {exemplo.favoravel.classe}{' '}
                                    {exemplo.favoravel.numero}
                                </dd>
                            </div>
                            <div>
                                <dt>Relator</dt>
                                <dd>{exemplo.favoravel.relator}</dd>
                            </div>
                            <div>
                                <dt>Publicação</dt>
                                <dd>{exemplo.favoravel.data}</dd>
                            </div>
                            <div>
                                <dt>Resultado</dt>
                                <dd>{exemplo.favoravel.resultado}</dd>
                            </div>
                        </dl>

                        <div class="abas">
                            <span class="aba aba-on">Favoráveis</span>
                            <span class="aba">Contrários</span>
                            <span class="aba">De distinção</span>
                        </div>

                        <div class="resultado">
                            <p class="trecho-txt">
                                …<mark>gera dano moral presumido</mark>,
                                dispensada a prova do prejuízo…
                            </p>
                            <a
                                href={exemplo.favoravel.link}
                                class="link-of"
                                target="_blank"
                                rel="noopener"
                            >
                                Abrir no site do tribunal
                            </a>
                        </div>
                    </div>
                    <figcaption>{exemplo.aviso}</figcaption>
                </figure>
            </div>
        </section>

        {/* ============================================
            Fatos
            ============================================ */}
        <section class="fatos">
            <div class="wrap fatos-grid">
                <p>
                    <strong>12 milhões</strong> de decisões
                </p>
                <p>
                    <strong>STJ e STF</strong> na mesma busca
                </p>
                <p>
                    <strong>Trecho literal</strong> e link oficial em cada uma
                </p>
            </div>
        </section>

        {/* ============================================
            Passos
            ============================================ */}
        <section class="passos" id="passos">
            <div class="wrap">
                <h2>Do caso ao precedente, em cinco passos</h2>

                <ol class="lista-passos">
                    {passos.map((passo, i) => (
                        <li class="passo">
                            <div class="passo-texto">
                                <span class="passo-n" aria-hidden="true">
                                    {i + 1}
                                </span>
                                <h3>{passo.titulo}</h3>
                                <p>{passo.texto}</p>
                            </div>

                            <div class="tela tela-p" role="img" aria-label="Tela ilustrativa do passo">
                                {passo.id === 'caso' && (
                                    <>
                                        <div class="tela-topo">
                                            Descrição do caso
                                        </div>
                                        <div class="tela-corpo">
                                            <p class="caso">
                                                {exemplo.caso.descricao}
                                            </p>
                                            <span class="btn-mini">
                                                Buscar precedentes
                                            </span>
                                        </div>
                                    </>
                                )}

                                {passo.id === 'plano' && (
                                    <>
                                        <div class="tela-topo">
                                            Plano de busca
                                        </div>
                                        <dl class="plano">
                                            <div>
                                                <dt>Teses</dt>
                                                <dd>{exemplo.plano.teses}</dd>
                                            </div>
                                            <div>
                                                <dt>Classes</dt>
                                                <dd>{exemplo.plano.classes}</dd>
                                            </div>
                                            <div>
                                                <dt>Filtros</dt>
                                                <dd>{exemplo.plano.filtros}</dd>
                                            </div>
                                        </dl>
                                    </>
                                )}

                                {passo.id === 'precedentes' && (
                                    <>
                                        <div class="tela-topo">Precedentes</div>
                                        <ul class="blocos">
                                            <li class="bloco bloco-fav">
                                                <b>Favoráveis</b>
                                                <span>
                                                    Trecho literal e link
                                                </span>
                                            </li>
                                            <li class="bloco bloco-con">
                                                <b>Contrários</b>
                                                <span>
                                                    Trecho literal e link
                                                </span>
                                            </li>
                                            <li class="bloco bloco-dis">
                                                <b>De distinção</b>
                                                <span>
                                                    Trecho literal e link
                                                </span>
                                            </li>
                                        </ul>
                                    </>
                                )}

                                {passo.id === 'trecho' && (
                                    <>
                                        <div class="tela-topo">
                                            Trecho e fonte
                                        </div>
                                        <div class="tela-corpo">
                                            <p class="trecho-txt">
                                                …
                                                <mark>
                                                    gera dano moral presumido
                                                </mark>
                                                , dispensada a prova do
                                                prejuízo…
                                            </p>
                                            <p class="acoes-mini">
                                                <a
                                                    href={
                                                        exemplo.favoravel.link
                                                    }
                                                    class="link-of"
                                                    target="_blank"
                                                    rel="noopener"
                                                >
                                                    Abrir no site do tribunal
                                                </a>
                                            </p>
                                        </div>
                                    </>
                                )}

                                {passo.id === 'decisao' && (
                                    <>
                                        <div class="tela-topo">
                                            Decisão completa
                                        </div>
                                        <dl class="plano">
                                            <div>
                                                <dt>Processo</dt>
                                                <dd>
                                                    {exemplo.favoravel.classe}{' '}
                                                    {exemplo.favoravel.numero}
                                                </dd>
                                            </div>
                                            <div>
                                                <dt>Relator</dt>
                                                <dd>
                                                    {exemplo.favoravel.relator}
                                                </dd>
                                            </div>
                                            <div>
                                                <dt>Publicação</dt>
                                                <dd>
                                                    {exemplo.favoravel.data}
                                                </dd>
                                            </div>
                                            <div>
                                                <dt>Resultado</dt>
                                                <dd>
                                                    {
                                                        exemplo.favoravel
                                                            .resultado
                                                    }
                                                </dd>
                                            </div>
                                        </dl>
                                    </>
                                )}
                            </div>
                        </li>
                    ))}
                </ol>

                <p class="nota-telas">{exemplo.aviso}</p>
            </div>
        </section>

        {/* ============================================
            Regra
            ============================================ */}
        <section class="regra">
            <div class="wrap regra-grid">
                <p class="regra-texto">
                    Tudo o que aparece vem da base, com trecho literal e link
                    oficial. Nada é inventado pela IA.
                </p>
                <ul class="regra-lista">
                    {regras.map((r) => (
                        <li>{r}</li>
                    ))}
                </ul>
            </div>
        </section>

        {/* ============================================
            Limites
            ============================================ */}
        <section class="limites">
            <div class="wrap">
                <h2>O que a pesquisa por caso não faz</h2>
                <dl class="limites-lista">
                    {limites.map((l) => (
                        <div class="limite">
                            <dt>{l.titulo}</dt>
                            <dd>{l.texto}</dd>
                        </div>
                    ))}
                </dl>
            </div>
        </section>

        {/* ============================================
            CTA final
            ============================================ */}
        <section class="cta">
            <div class="wrap cta-grid">
                <div>
                    <h2>Peça acesso e faça uma pesquisa por caso.</h2>
                    <p>
                        Veja os precedentes do seu caso, cada um com a fonte
                        oficial.
                    </p>
                </div>
                <a href="/pedir-acesso" class="btn btn-claro">
                    Pedir acesso
                </a>
            </div>
        </section>
    </div>
</Layout>

<style>
    /* ============================================
       Escopo da página — usa variáveis do global.css
       ============================================ */
    .cf {
        background: var(--color-papel);
        color: var(--color-tinta);
        font-family: var(--font-corpo);
        font-size: 1.0625rem;
        line-height: 1.6;
    }

    .cf .wrap {
        max-width: 70rem;
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    .cf h1,
    .cf h2,
    .cf h3 {
        font-family: var(--font-titulo);
        color: inherit;
        margin: 0;
        letter-spacing: -0.01em;
    }

    .cf h1 {
        font-size: clamp(2.3rem, 5vw, 3.7rem);
        font-weight: 700;
        line-height: 1.04;
        margin-bottom: 1.5rem;
    }

    .cf h2 {
        font-size: clamp(1.6rem, 3vw, 2.2rem);
        font-weight: 600;
        line-height: 1.15;
    }

    .cf h3 {
        font-size: 1.4rem;
        font-weight: 600;
        line-height: 1.25;
        margin-bottom: 0.5rem;
    }

    .cf p,
    .cf ul,
    .cf ol,
    .cf dl,
    .cf dd,
    .cf figure {
        margin: 0;
    }

    .cf ul,
    .cf ol {
        list-style: none;
        padding: 0;
    }

    .cf .lead {
        font-size: 1.15rem;
        color: var(--color-tinta);
        max-width: 34rem;
        margin-bottom: 2rem;
    }

    /* ============================================
       Ações e botões
       ============================================ */
    .cf .acoes {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1.5rem;
    }

    .cf .btn {
        display: inline-block;
        background: var(--color-verde);
        color: #ffffff;
        font-weight: 600;
        text-decoration: none;
        padding: 0.85rem 1.6rem;
        border-radius: 4px;
        transition: background-color 0.15s ease;
    }

    .cf .btn:hover {
        background: var(--color-verde-claro);
    }

    .cf .btn-claro {
        background: #ffffff;
        color: var(--color-verde);
    }

    .cf .btn-claro:hover {
        background: var(--color-mostarda);
    }

    .cf .link {
        color: var(--color-tinta);
        font-weight: 500;
        text-decoration: underline;
        text-underline-offset: 0.3em;
        text-decoration-thickness: 1px;
    }

    .cf .link:hover {
        color: var(--color-verde);
    }

    .cf .btn:focus-visible,
    .cf .link:focus-visible {
        outline: 3px solid var(--color-mostarda);
        outline-offset: 3px;
    }

    .cf .cta .btn:focus-visible {
        outline-color: #ffffff;
    }

    /* ============================================
       Telas ilustrativas
       ============================================ */
    .cf .tela {
        background: #ffffff;
        border: 1px solid var(--color-borda);
        border-radius: 10px;
        overflow: hidden;
        box-shadow:
            0 1px 0 var(--color-borda),
            0 26px 50px -34px rgba(22, 35, 31, 0.55);
    }

    .cf .tela-topo {
        background: var(--color-papel-escuro);
        border-bottom: 1px solid var(--color-borda);
        padding: 0.6rem 1.1rem;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--color-tinta-suave);
    }

    .cf .tela-corpo {
        padding: 1.1rem;
        display: grid;
        gap: 1rem;
    }

    .cf .tela figcaption {
        padding: 0.55rem 1.1rem;
        border-top: 1px solid var(--color-borda);
        font-size: 0.8rem;
        font-style: italic;
        color: var(--color-tinta-suave);
    }

    .cf .caso {
        font-size: 0.95rem;
        color: var(--color-tinta);
        background: var(--color-papel);
        border: 1px solid var(--color-borda);
        border-radius: 6px;
        padding: 0.7rem 0.9rem;
    }

    .cf .abas {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem;
        border-bottom: 1px solid var(--color-borda);
    }

    .cf .aba {
        padding: 0.4rem 0.8rem;
        font-size: 0.9rem;
        color: var(--color-tinta-suave);
        border-bottom: 2px solid transparent;
        margin-bottom: -1px;
    }

    .cf .aba-on {
        color: var(--color-verde);
        font-weight: 600;
        border-bottom-color: var(--color-verde);
    }

    .cf .trecho-txt {
        font-family: var(--font-titulo);
        font-size: 1.12rem;
        line-height: 1.55;
    }

    .cf mark {
        background: var(--color-mostarda);
        color: inherit;
        padding: 0.05em 0.15em;
        -webkit-box-decoration-break: clone;
        box-decoration-break: clone;
    }

    .cf .link-of {
        display: inline-block;
        margin-top: 0.7rem;
        color: var(--color-verde);
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: underline;
        text-underline-offset: 0.25em;
        text-decoration-thickness: 1px;
    }

    .cf .acoes-mini {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem 1.5rem;
    }

    .cf .acoes-mini .link-of {
        margin-top: 0;
    }

    .cf .btn-mini {
        justify-self: start;
        background: var(--color-verde);
        color: #ffffff;
        font-size: 0.88rem;
        font-weight: 600;
        padding: 0.45rem 0.9rem;
        border-radius: 5px;
    }

    .cf .resultado {
        padding: 0 0 0.25rem;
    }

    .cf .plano {
        padding: 0.4rem 1.1rem 0.6rem;
    }

    .cf .plano > div {
        display: grid;
        grid-template-columns: 6rem 1fr;
        gap: 1rem;
        padding: 0.7rem 0;
        border-bottom: 1px solid var(--color-borda);
        font-size: 0.95rem;
    }

    .cf .plano > div:last-child {
        border-bottom: none;
    }

    .cf .plano dt {
        color: var(--color-tinta-suave);
    }

    .cf .plano dd {
        font-weight: 500;
        font-variant-numeric: tabular-nums;
    }

    .cf .blocos {
        padding: 1.1rem;
        display: grid;
        gap: 0.6rem;
    }

    .cf .bloco {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0.2rem 1rem;
        border: 1px solid var(--color-borda);
        border-left: 5px solid;
        border-radius: 4px;
        padding: 0.6rem 0.9rem;
        font-size: 0.92rem;
    }

    .cf .bloco span {
        color: var(--color-tinta-suave);
    }

    .cf .bloco-fav {
        border-left-color: var(--color-tinta);
    }

    .cf .bloco-con {
        border-left-color: var(--color-tinta);
    }

    .cf .bloco-dis {
        border-left-color: var(--color-tinta);
    }

    /* ============================================
       Hero
       ============================================ */
    .cf .hero {
        padding: 4.5rem 0 4rem;
    }

    .cf .hero-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 3.5rem;
        align-items: center;
    }

    /* ============================================
       Fatos
       ============================================ */
    .cf .fatos {
        border-top: 1px solid var(--color-borda);
        border-bottom: 1px solid var(--color-borda);
        background: #ffffff;
    }

    .cf .fatos-grid {
        display: grid;
        grid-template-columns: 1fr;
    }

    .cf .fatos p {
        padding: 1.1rem 0;
        color: var(--color-tinta-suave);
        border-top: 1px solid var(--color-borda);
    }

    .cf .fatos p:first-child {
        border-top: none;
    }

    .cf .fatos strong {
        color: var(--color-tinta);
        font-family: var(--font-titulo);
        font-size: 1.3rem;
        font-weight: 700;
    }

    /* ============================================
       Passos
       ============================================ */
    .cf .passos {
        padding: 5rem 0 4.5rem;
    }

    .cf .lista-passos {
        margin-top: 2.5rem;
    }

    .cf .passo {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.75rem;
        padding: 2.75rem 0;
        border-top: 1px solid var(--color-borda);
        align-items: center;
    }

    .cf .passo-n {
        display: block;
        font-family: var(--font-titulo);
        font-size: 3.2rem;
        font-weight: 700;
        line-height: 1;
        color: var(--color-verde);
        margin-bottom: 0.75rem;
    }

    .cf .passo-texto p {
        color: var(--color-tinta);
        max-width: 30rem;
    }

    .cf .nota-telas {
        margin-top: 1.5rem;
        font-size: 0.85rem;
        font-style: italic;
        color: var(--color-tinta-suave);
    }

    /* ============================================
       Regra de ouro
       ============================================ */
    .cf .regra {
        background: var(--color-tinta);
        color: var(--color-papel);
        padding: 4.5rem 0;
    }

    .cf .regra-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2.5rem;
        align-items: center;
    }

    .cf .regra-texto {
        font-family: var(--font-titulo);
        font-size: clamp(1.6rem, 3.4vw, 2.4rem);
        color: var(--color-papel);
        font-weight: 600;
        line-height: 1.2;
        letter-spacing: -0.01em;
    }

    .cf .regra-lista {
        color: #c7d2ce;
    }

    .cf .regra-lista li {
        padding: 0.9rem 0;
        border-top: 1px solid rgba(238, 242, 240, 0.15);
    }

    .cf .regra-lista li:last-child {
        border-bottom: 1px solid rgba(238, 242, 240, 0.15);
    }

    /* ============================================
       Limites
       ============================================ */
    .cf .limites {
        padding: 5rem 0 4.5rem;
    }

    .cf .limites-lista {
        margin-top: 2rem;
    }

    .cf .limite {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.25rem 2rem;
        padding: 1.25rem 0;
        border-top: 1px solid var(--color-borda);
    }

    .cf .limite:last-child {
        border-bottom: 1px solid var(--color-borda);
    }

    .cf .limite dt {
        font-family: var(--font-titulo);
        font-size: 1.3rem;
        font-weight: 600;
        line-height: 1.25;
    }

    .cf .limite dd {
        color: var(--color-tinta);
    }

    /* ============================================
       CTA final
       ============================================ */
    .cf .cta {
        background: var(--color-verde);
        color: #ffffff;
        padding: 4.5rem 0;
    }

    .cf .cta-grid {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 2rem;
    }

    .cf .cta h2 {
        max-width: 30rem;
        margin-bottom: 0.75rem;
    }

    .cf .cta p {
        color: rgba(255, 255, 255, 0.8);
        max-width: 30rem;
    }

    /* ============================================
       Telas maiores
       ============================================ */
    @media (min-width: 48rem) {
        .cf .fatos-grid {
            grid-template-columns: repeat(3, 1fr);
        }

        .cf .fatos p {
            border-top: none;
            border-left: 1px solid var(--color-borda);
            padding: 1.4rem 1.5rem;
        }

        .cf .fatos p:first-child {
            border-left: none;
            padding-left: 0;
        }

        .cf .limite {
            grid-template-columns: 5fr 7fr;
            align-items: baseline;
        }

        .cf .cta-grid {
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
            gap: 3rem;
        }
    }

    @media (min-width: 64rem) {
        .cf .hero-grid {
            grid-template-columns: 6fr 5fr;
            gap: 5rem;
        }

        .cf .passo {
            grid-template-columns: 5fr 6fr;
            gap: 5rem;
            padding: 3.5rem 0;
        }

        .cf .passo:nth-child(even) .passo-texto {
            order: 2;
        }

        .cf .regra-grid {
