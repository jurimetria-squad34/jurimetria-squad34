---
// ============================================
// Imports
// ============================================
import dados from '../config/planos.json';
import Layout from '../layouts/Layout.astro';

const { planos, faq } = dados;

const inclusos = [
    '12 milhões de decisões',
    'STJ e STF na mesma busca',
    'Trecho literal e link oficial em cada uma',
];
---

<Layout
    title="Planos — Jurimetria"
    description="Planos do Jurimetria para advogados autônomos e escritórios. Jurisprudência verificável do STJ e do STF, com trecho literal e link oficial."
>
    <div class="bg-papel text-tinta font-corpo text-base leading-relaxed">
        {/* ============================================
            Hero
            ============================================ */}
        <section class="pt-20 pb-14">
            <div class="max-w-5xl mx-auto px-6 grid grid-cols-1 md:grid-cols-12 gap-7 items-end">
                <h1 class="md:col-span-7 font-titulo text-4xl md:text-5xl font-bold leading-[1.08] tracking-tight">
                    Jurisprudência verificável, no ritmo do seu escritório.
                </h1>
                <p class="md:col-span-5 text-tinta-suave text-lg">
                    Dois planos, um para advogado autônomo e outro para
                    escritórios com equipe. Todos incluem as 12 milhões de
                    decisões do STJ e do STF, com trecho literal e link oficial
                    em cada uma.
                </p>
            </div>
        </section>

        {/* ============================================
            Planos
            ============================================ */}
        <section class="pb-20">
            <div class="max-w-5xl mx-auto px-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
                    {planos.map((plano) => (
                        <article
                            class:list={[
                                'relative flex flex-col gap-6 p-8 bg-white rounded-lg',
                                plano.destaque
                                    ? 'border-2 border-verde shadow-2xl shadow-tinta/10'
                                    : 'border border-borda',
                            ]}
                        >
                            {plano.destaque && (
                                <p class="absolute -top-3 left-8 bg-verde text-white text-xs font-semibold tracking-wide uppercase px-3 py-1 rounded">
                                    Mais escolhido
                                </p>
                            )}

                            <header class="flex flex-col gap-2">
                                <h2 class="font-titulo text-2xl font-semibold">
                                    {plano.nome}
                                </h2>
                                <p class="text-sm text-tinta-suave">
                                    {plano.descricao}
                                </p>
                            </header>

                            <p class="flex items-baseline gap-1 pb-6 border-b border-borda">
                                <span class="font-mono text-5xl font-medium leading-none tracking-tight">
                                    {plano.preco}
                                </span>
                                <span class="text-tinta-suave">
                                    {plano.periodo}
                                </span>
                            </p>

                            <ul class="flex flex-col gap-3 list-none p-0 m-0 flex-1">
                                {plano.recursos.map((recurso) => (
                                    <li class="relative pl-6 recurso">
                                        {recurso}
                                    </li>
                                ))}
                            </ul>

                            <a
                                href="/pedir-acesso"
                                class:list={[
                                    'block text-center font-semibold no-underline py-3 px-6 rounded transition-colors',
                                    plano.destaque
                                        ? 'bg-verde text-white hover:bg-verde-claro'
                                        : 'border border-tinta text-tinta hover:bg-tinta hover:text-papel',
                                ]}
                            >
                                Pedir acesso
                            </a>
                        </article>
                    ))}
                </div>

                <p class="mt-5 text-sm italic text-tinta-suave">
                    Os valores finais serão definidos em breve. Ao pedir acesso,
                    você recebe a proposta atualizada.
                </p>

                {/* ============================================
                    Faixa de inclusos
                    ============================================ */}
                <ul
                    class="grid grid-cols-1 md:grid-cols-3 mt-12 list-none p-0 border-t border-borda md:border-b md:border-borda"
                    aria-label="Incluso em todos os planos"
                >
                    {inclusos.map((item, i) => (
                        <li
                            class:list={[
                                'font-titulo text-xl font-medium border-b border-borda md:border-b-0 md:border-l md:border-borda py-4 md:py-5 md:px-6',
                                i === 0 && 'md:border-l-0 md:pl-0',
                            ]}
                        >
                            {item}
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        {/* ============================================
            FAQ
            ============================================ */}
        <section class="bg-white border-t border-borda py-20">
            <div class="max-w-5xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-20 items-start">
                <div class="lg:col-span-4 lg:sticky lg:top-8">
                    <h2 class="font-titulo text-3xl font-semibold">
                        Perguntas frequentes
                    </h2>
                    <p class="mt-4 text-tinta-suave max-w-xs">
                        Ficou alguma dúvida? Peça acesso e a gente responde na
                        conversa.
                    </p>
                </div>

                <div class="lg:col-span-8">
                    {faq.map((item, i) => (
                        <details
                            class="faq-item border-t border-borda last:border-b last:border-borda"
                            open={i === 0}
                        >
                            <summary class="faq-pergunta">
                                <span class="flex-1">{item.pergunta}</span>
                                <span
                                    class="faq-icone"
                                    aria-hidden="true"
                                ></span>
                            </summary>
                            <div class="faq-resposta">
                                <p>{item.resposta}</p>
                            </div>
                        </details>
                    ))}
                </div>
            </div>
        </section>

        {/* ============================================
            CTA final
            ============================================ */}
        <section class="bg-verde text-white py-20">
            <div class="max-w-5xl mx-auto px-6 flex flex-col md:flex-row md:items-center md:justify-between gap-8">
                <div>
                    <h2 class="font-titulo text-3xl font-semibold mb-3 max-w-lg">
                        Peça acesso e veja o Jurimetria por dentro.
                    </h2>
                    <p class="text-white/80 max-w-lg">
                        Nós entramos em contato para apresentar o produto e
                        liberar o acesso.
                    </p>
                </div>
                <a
                    href="/pedir-acesso"
                    class="inline-block bg-white text-verde font-semibold no-underline py-3 px-6 rounded transition-colors hover:bg-mostarda focus-visible:outline-3 focus-visible:outline-white focus-visible:outline-offset-3"
                >
                    Pedir acesso
                </a>
            </div>
        </section>
    </div>
</Layout>

<style>
    /* ============================================
       Bolinha verde nos recursos do plano
       Precisa de CSS próprio por causa do ::before
       ============================================ */
    .recurso::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0.55em;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--color-verde);
    }

    /* ============================================
       FAQ — acordeão com <details>/<summary>
       ============================================ */
    .faq-pergunta {
        display: flex; /*  */
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.3rem 0;
        cursor: pointer;
        list-style: none;
        font-family: var(--font-titulo);
        font-size: 1.2rem;
        font-weight: 600;
        line-height: 1.35;
        transition: color 0.15s ease;
    }

    .faq-pergunta::-webkit-details-marker {
        display: none;
    }
    .faq-pergunta::marker {
        content: '';
    }

    .faq-pergunta:hover {
        color: var(--color-verde);
    }

    .faq-pergunta:focus-visible {
        outline: 3px solid var(--color-mostarda);
        outline-offset: 3px;
        border-radius: 4px;
    }

    /* Ícone +/− desenhado em CSS */
    .faq-icone {
        position: relative;
        flex-shrink: 0;
        width: 20px;
        height: 20px;
    }

    .faq-icone::before,
    .faq-icone::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        background: var(--color-verde);
        transition:
            transform 0.2s ease,
            opacity 0.2s ease;
    }

    .faq-icone::before {
        width: 14px;
        height: 2px;
        transform: translate(-50%, -50%);
    }
    .faq-icone::after {
        width: 2px;
        height: 14px;
        transform: translate(-50%, -50%);
    }

    details[open] .faq-icone::after {
        transform: translate(-50%, -50%) rotate(90deg);
        opacity: 0;
    }

    .faq-resposta {
        padding: 0 0 1.4rem;
        max-width: 40rem;
        color: var(--color-tinta-suave);
    }

    .faq-resposta p {
        margin: 0;
    }

    @media (prefers-reduced-motion: no-preference) {
        details[open] .faq-resposta {
            animation: faq-abrir 0.2s ease-out;
        }
        @keyframes faq-abrir {
            from {
                opacity: 0;
                transform: translateY(-4px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    }
</style>
