---
// ============================================
// Imports
// ============================================
// Nenhum import externo — o Footer é autossuficiente.

// ============================================
// Dados do rodapé
// ============================================
const ano = new Date().getFullYear();

const grupos = [
    {
        titulo: 'Produto',
        links: [
            { texto: 'Como funciona', href: '/como-funciona' },
            { texto: 'Planos', href: '/planos' },
            { texto: 'Conteúdo', href: '/conteudo' },
            { texto: 'Pedir acesso', href: '/pedir-acesso' },
        ],
    },
    {
        titulo: 'Legal',
        links: [
            { texto: 'Privacidade', href: '/privacidade' },
            { texto: 'Termos de uso', href: '/termos' },
        ],
    },
];
---

<footer class="rodape">
    <div class="rodape-wrap">
        {/* ============================================
            Topo — marca + grupos de links
            ============================================ */}
        <div class="rodape-topo">
            {/* Marca */}
            <div class="rodape-marca">
                <p class="rodape-nome">Jurimetria</p>
                <p class="rodape-desc">
                    Jurisprudência verificável do STJ e do STF.
                </p>
            </div>

            {/* Grupos de links (Produto, Legal) */}
            <div class="rodape-links">
                {grupos.map((grupo) => (
                    <nav class="rodape-grupo" aria-label={grupo.titulo}>
                        <span class="rodape-titulo">{grupo.titulo}</span>
                        <ul>
                            {grupo.links.map((link) => (
                                <li>
                                    <a href={link.href}>{link.texto}</a>
                                </li>
                            ))}
                        </ul>
                    </nav>
                ))}
            </div>
        </div>

        {/* ============================================
            Fim — copyright + aviso legal
            ============================================ */}
        <div class="rodape-fim">
            <p>© {ano} Jurimetria. Todos os direitos reservados.</p>
            <p>O Jurimetria não substitui a análise de um advogado.</p>
        </div>
    </div>
</footer>

<style>
    /* ============================================
       Escopo — base do rodapé
       ============================================ */
    .rodape {
        background: var(--color-tinta);
        color: var(--color-papel);
        font-family: var(--font-corpo);
        font-size: 0.9rem;
        line-height: 1.5;
        margin-top: 6rem;
    }

    /* Reset local — evita que os estilos globais interfiram */
    .rodape p,
    .rodape ul {
        margin: 0;
    }

    /* ============================================
       Container — alinhado com o resto do site
       ============================================ */
    .rodape-wrap {
        max-width: 70rem;
        margin: 0 auto;
        padding: 1.75rem 1.5rem 1.25rem;
    }

    /* ============================================
       Topo — marca + links
       ============================================ */
    .rodape-topo {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        padding-bottom: 1.25rem;
    }

    /* Marca */
    .rodape-nome {
        font-family: var(--font-titulo);
        font-size: 1.3rem;
        font-weight: 700;
        line-height: 1.1;
        margin-bottom: 0.3rem;
        color: var(--color-papel);
    }

    .rodape-desc {
        color: var(--color-tinta-suave);
    }

    /* Grupos de links */
    .rodape-links {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .rodape-grupo {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.2rem 1.5rem;
    }

    .rodape-titulo {
        font-weight: 600;
        min-width: 4.5rem;
        color: var(--color-papel);
    }

    .rodape ul {
        display: flex;
        flex-wrap: wrap;
        gap: 0.2rem 1.5rem;
        list-style: none;
        padding: 0;
    }

    /* ============================================
       Links — estados de hover e foco
       ============================================ */
    .rodape a {
        color: var(--color-tinta-suave);
        text-decoration: none;
        transition: color 0.15s ease;
    }

    .rodape a:hover {
        color: var(--color-papel);
        text-decoration: underline;
        text-underline-offset: 0.25em;
        text-decoration-thickness: 1px;
    }

    .rodape a:focus-visible {
        outline: 3px solid var(--color-mostarda);
        outline-offset: 3px;
        border-radius: 2px;
    }

    /* ============================================
       Fim — copyright + aviso legal
       ============================================ */
    .rodape-fim {
        display: flex;
        flex-direction: column;
        gap: 0.2rem 2rem;
        color: var(--color-tinta-suave);
        font-size: 0.825rem;
    }

    /* ============================================
       Telas maiores (≥48rem)
       ============================================ */
    @media (min-width: 48rem) {
        .rodape-topo {
            flex-direction: row;
            justify-content: space-between;
            align-items: flex-start;
            gap: 3rem;
        }

        .rodape-fim {
            flex-direction: row;
            justify-content: space-between;
        }
    }
</style>
