---
// ============================================
// Dropdown customizado do formulário de acesso
// Renderiza label + select nativo escondido +
// botão + lista. O comportamento (abrir, fechar,
// teclado) é controlado pelo script em pedir-acesso.astro.
// ============================================

// ============================================
// Props
// ============================================
interface Props {
    /** ID do campo (usado no for, id e name) */
    id: string;
    /** Rótulo visível */
    rotulo: string;
    /** Opções do dropdown */
    opcoes: string[];
    /** Se o campo é obrigatório */
    required?: boolean;
    /** Se ocupa a linha inteira do grid */
    cheio?: boolean;
}

const { id, rotulo, opcoes, required = false, cheio = false } = Astro.props;
---

<div class:list={['grupo', { cheio }]}>
    <label for={id} id={`rotulo-${id}`} class="rotulo">
        {rotulo}
    </label>
    <div class="dd">
        <select
            id={id}
            name={id}
            required={required}
            class="nativo"
            aria-describedby={`erro-${id}`}
            tabindex="-1"
            aria-hidden="true"
        >
            <option value="">Selecione…</option>
            {opcoes.map((opcao) => (
                <option value={opcao}>{opcao}</option>
            ))}
        </select>
        <button
            type="button"
            class="dd-btn vazio"
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-labelledby={`rotulo-${id} valor-${id}`}
        >
            <span class="dd-valor" id={`valor-${id}`}>
                Selecione…
            </span>
            <span class="seta" aria-hidden="true"></span>
        </button>
        <ul
            class="dd-lista"
            role="listbox"
            tabindex="-1"
            aria-labelledby={`rotulo-${id}`}
            hidden
        ></ul>
    </div>
    <p id={`erro-${id}`} class="erro" hidden></p>
</div>

<style>
    /* ============================================
       Grupo do campo
       ============================================ */
    .grupo {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    /* ============================================
       Rótulo
       ============================================ */
    .rotulo {
        font-size: 0.92rem;
        font-weight: 600;
        color: var(--color-tinta);
    }

    /* ============================================
       Container do dropdown
       ============================================ */
    .dd {
        position: relative;
    }

    /* ============================================
       Select nativo escondido
       ============================================ */
    .nativo {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        pointer-events: none;
    }

    /* ============================================
       Botão do dropdown
       ============================================ */
    .dd-btn {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        width: 100%;
        box-sizing: border-box;
        text-align: left;
        padding: 0.8rem 2.75rem 0.8rem 0.95rem;
        font-family: var(--font-corpo);
        font-size: 1rem;
        color: var(--color-tinta);
        background: var(--color-papel);
        border: 1px solid var(--color-borda);
        border-radius: 6px;
        cursor: pointer;
        transition:
            border-color 0.15s ease,
            box-shadow 0.15s ease,
            background-color 0.15s ease;
    }

    .dd-btn:hover {
        border-color: #aab5b1;
    }

    .dd-btn.vazio .dd-valor {
        color: var(--color-tinta-suave);
    }

    .dd-btn:focus-visible,
    .dd.aberto .dd-btn {
        outline: none;
        background: #ffffff;
        border-color: var(--color-verde);
        box-shadow: 0 0 0 3px rgba(15, 92, 77, 0.18);
    }

    .nativo[aria-invalid='true'] ~ .dd-btn {
        border-color: #b00020;
    }

    /* ============================================
       Seta
       ============================================ */
    .seta {
        position: absolute;
        right: 1.1rem;
        top: 50%;
        width: 8px;
        height: 8px;
        border-right: 1.5px solid var(--color-tinta-suave);
        border-bottom: 1.5px solid var(--color-tinta-suave);
        transform: translateY(-70%) rotate(45deg);
        transition:
            transform 0.15s ease,
            border-color 0.15s ease;
        pointer-events: none;
    }

    .dd.aberto .seta {
        transform: translateY(-30%) rotate(225deg);
        border-color: var(--color-verde);
    }

    /* ============================================
       Lista de opções
       ============================================ */
    .dd-lista {
        position: absolute;
        z-index: 30;
        left: 0;
        right: 0;
        top: calc(100% + 6px);
        max-height: 15rem;
        overflow-y: auto;
        margin: 0;
        padding: 0.35rem;
        list-style: none;
        background: #ffffff;
        border: 1px solid var(--color-borda);
        border-radius: 8px;
        box-shadow: 0 18px 40px -16px rgba(22, 35, 31, 0.4);
        outline: none;
    }

    .dd-lista[hidden] {
        display: none;
    }

    .dd.acima .dd-lista {
        top: auto;
        bottom: calc(100% + 6px);
    }

    /* ============================================
       Itens da lista (criados pelo script)
       ============================================ */
    :global(.dd-item) {
        position: relative;
        padding: 0.6rem 2.25rem 0.6rem 0.8rem;
        border-radius: 5px;
        font-size: 0.98rem;
        cursor: pointer;
    }

    :global(.dd-item.ativo) {
        background: #e9eeec;
    }

    :global(.dd-item.sel) {
        font-weight: 600;
        color: var(--color-verde);
    }

    :global(.dd-item.sel)::after {
        content: '';
        position: absolute;
        right: 1rem;
        top: 50%;
        width: 0.3rem;
        height: 0.6rem;
        border-right: 2px solid var(--color-verde);
        border-bottom: 2px solid var(--color-verde);
        transform: translateY(-62%) rotate(45deg);
    }

    /* ============================================
       Mensagem de erro
       ============================================ */
    .erro {
        font-size: 0.85rem;
        color: #b00020;
        margin: 0;
    }
</style>
