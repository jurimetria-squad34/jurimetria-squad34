---
// ============================================
// Select nativo estilizado do formulário
// Rótulo, erro e teclado funcionam pelo navegador.
// ============================================
interface Props {
    id: string;
    rotulo: string;
    opcoes: string[];
    required?: boolean;
    cheio?: boolean;
}

const { id, rotulo, opcoes, required = false, cheio = false } = Astro.props;
---

<div class:list={['grupo', { cheio }]}>
    <label for={id} class="rotulo">{rotulo}</label>
    <div class="caixa">
        <select
            id={id}
            name={id}
            required={required}
            class="nativo"
            aria-describedby={`erro-${id}`}
        >
            <option value="">Selecione…</option>
            {opcoes.map((opcao) => <option value={opcao}>{opcao}</option>)}
        </select>
        <span class="seta" aria-hidden="true"></span>
    </div>
    <p id={`erro-${id}`} class="erro" hidden></p>
</div>

<style>
    .grupo {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .rotulo {
        font-size: 0.92rem;
        font-weight: 600;
        color: var(--color-tinta);
    }

    .caixa {
        position: relative;
    }

    .nativo {
        appearance: none;
        -webkit-appearance: none;
        width: 100%;
        box-sizing: border-box;
        padding: 0.8rem 2.75rem 0.8rem 0.95rem;
        font-family: var(--font-corpo);
        font-size: 1rem;
        color: var(--color-tinta);
        background: var(--color-papel);
        border: 1px solid var(--color-borda);
        border-radius: 6px;
        cursor: pointer;
        transition:
            border-color 0.15s ease,
            box-shadow 0.15s ease,
            background-color 0.15s ease;
    }

    .nativo:required:invalid {
        color: var(--color-tinta-suave);
    }

    .nativo option {
        color: var(--color-tinta);
    }

    .nativo:hover {
        border-color: #aab5b1;
    }

    .nativo:focus-visible {
        outline: none;
        background: #ffffff;
        border-color: var(--color-verde);
        box-shadow: 0 0 0 3px rgba(15, 92, 77, 0.18);
    }

    .nativo[aria-invalid='true'] {
        border-color: #b00020;
    }

    .seta {
        position: absolute;
        right: 1.1rem;
        top: 50%;
        width: 8px;
        height: 8px;
        border-right: 1.5px solid var(--color-tinta-suave);
        border-bottom: 1.5px solid var(--color-tinta-suave);
        transform: translateY(-70%) rotate(45deg);
        pointer-events: none;
    }

    .erro {
        font-size: 0.85rem;
        color: #b00020;
        margin: 0;
    }
</style>
