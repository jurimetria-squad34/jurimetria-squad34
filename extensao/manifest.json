{
  "manifest_version": 3,
  "name": "Jurimetria no tribunal",
  "version": "1.0.0",
  "description": "Mostra uma ficha da decisão ao passar o mouse no número do processo.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "dist/fundo.js"
  },
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://processo.stj.jus.br/*",
    "https://scon.stj.jus.br/*",
    "https://portal.stf.jus.br/*"
  ],
  "options_page": "opcoes.html",
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "https://processo.stj.jus.br/*",
        "https://scon.stj.jus.br/*",
        "https://portal.stf.jus.br/*"
      ],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
