---
// ============================================
// Imports
// ============================================
import exemplo from '../data/exemplo.json';
import relatores from '../data/relatores.json';
import universo from '../data/universo.json';
import Layout from '../layouts/Layout.astro';

// ============================================
// Dados da base
// ============================================
const { tribunais, decisoes, de, ate } = universo.universo;
const total = decisoes.toLocaleString('pt-BR');
const listaTribunais = new Intl.ListFormat('pt-BR', {
    style: 'long',
    type: 'conjunction',
}).format(tribunais);

// ============================================
// Funções do produto
// ============================================
const funcoes = [
    {
        titulo: 'Busca de jurisprudência',
        resumo: 'Pesquisa por palavra ou por sentido em toda a base de decisões.',
        imagem: '',
    },
    {
        titulo: 'Tela da decisão',
        resumo: 'Ementa, inteiro teor e link oficial do tribunal na mesma página.',
        imagem: '',
    },
    {
        titulo: 'Jurimetria',
        resumo: 'Taxa de decisões favoráveis por classe, matéria, relator e ano.',
        imagem: '',
    },
    {
        titulo: 'Pesquisa por caso',
        resumo: 'Precedentes separados em favoráveis, contrários e de distinção.',
        imagem: '',
    },
    {
        titulo: 'Alertas',
        resumo: 'Aviso quando entra decisão nova que casa com a sua busca.',
        imagem: '',
    },
];

// ============================================
// Selo de prova social
// ============================================
const selos = [
    { pct: 100, texto: 'das decisões exibidas têm link oficial do tribunal' },
    { pct: 100, texto: 'dos trechos conferem com o texto original' },
    { pct: 100, texto: 'das taxas mostram universo, período e critério' },
];

// ============================================
// Problemas que o produto resolve
// ============================================
const dores = [
    {
        titulo: 'Busca por palavra perde o que importa',
        texto: 'A decisão certa usa outras palavras. Você não acha, e a parte contrária acha.',
    },
    {
        titulo: 'Precedente sem fonte não se sustenta',
        texto: 'Citar de memória ou de resumo de IA expõe você. O juiz confere.',
    },
    {
        titulo: 'Estratégia sem número',
        texto: 'Sem número, o cliente decide no escuro. E você também.',
    },
];

// ============================================
// Relatores — dados reais do observatorio.json
// ============================================
const barras = relatores.relatores.map((r) => ({
    rotulo: r.nome,
    pct: r.basePequena || r.taxa === null ? null : Math.round(r.taxa * 100),
    total: r.total,
    favoraveis: r.favoraveis,
}));

// ============================================
// Como funciona
// ============================================
const passos = [
    {
        titulo: 'Descreva o caso',
        texto: 'Escreva os fatos e a tese com as suas palavras.',
    },
    {
        titulo: 'Receba os precedentes separados',
        texto: 'Favoráveis, contrários e de distinção. Cada um com trecho literal.',
    },
    {
        titulo: 'Confira no tribunal',
        texto: 'Um clique abre a decisão no site oficial. Confira antes de citar.',
    },
];

// ============================================
// Garantias de verificação
// ============================================
const garantias = [
    {
        titulo: 'Trecho literal',
        texto: 'O que aparece entre aspas está na decisão. Palavra por palavra.',
    },
    {
        titulo: 'Link oficial',
        texto: 'Toda decisão aponta para o site do tribunal.',
    },
    {
        titulo: 'Sem invenção',
        texto: 'A IA organiza o que existe na base. Não cria decisão.',
    },
];

// ============================================
// Limites do produto
// ============================================
const limites = [
    'Não gera petição.',
    'Não prevê o resultado de um processo.',
    'Não busca por nome de parte.',
];
---

<Layout
    title="Jurimetria — jurisprudência verificável do STJ e do STF"
    description="Pesquisa de jurisprudência, jurimetria e pesquisa por caso com IA, com trecho literal e link oficial em cada decisão."
>
    <div class="bg-papel text-tinta font-corpo text-[1.0625rem] leading-relaxed">
        {/* Hero */}
        <section class="pt-12 md:pt-20 pb-12 md:pb-18">
            <div class="container-site grid grid-cols-1 md:grid-cols-12 gap-14 items-center">
                <div class="md:col-span-7">
                    <h1 class="font-titulo text-4xl md:text-5xl lg:text-6xl font-bold leading-[1.08] tracking-tight mb-7">
                        Saiba como o STJ e o STF decidem antes de protocolar.
                    </h1>

                    <p class="text-lg max-w-xl mb-4">
                        Ache o precedente certo, veja a taxa de decisões favoráveis por relator e confira tudo na fonte.
                    </p>
                    <p class="text-lg max-w-xl mb-9 text-tinta-suave">
                        {total} decisões. Cada uma com trecho literal e link
                        oficial.
                    </p>

                    <div class="flex flex-wrap items-center gap-6">
                        <a href="/pedir-acesso" class="botao botao-primario">
                            Pedir acesso
                        </a>
                        <a
                            href="/como-funciona"
                            class="font-medium text-tinta underline underline-offset-[0.3em] decoration-1 hover:text-verde transition-colors"
                        >
                            Como funciona
                        </a>
                    </div>
                </div>

                <div class="md:col-span-5" data-hero-tabs>
                    <div
                        role="tablist"
                        aria-label="Exemplos do produto"
                        class="flex flex-wrap gap-2 mb-3"
                    >
                        <button
                            type="button"
                            role="tab"
                            id="tab-decisao"
                            aria-controls="painel-decisao"
                            aria-selected="false"
                            tabindex="-1"
                            class="hero-tab"
                        >
                            Decisão com fonte
                        </button>
                        <button
                            type="button"
                            role="tab"
                            id="tab-jurimetria"
                            aria-controls="painel-jurimetria"
                            aria-selected="true"
                            class="hero-tab"
                        >
                            Jurimetria por relator
                        </button>
                    </div>

                    <figure
                    id="painel-decisao"
                    role="tabpanel"
                    aria-labelledby="tab-decisao"
                    hidden
                    class="m-0 bg-white border border-borda rounded-lg p-6 pb-5 shadow-2xl shadow-tinta/10"
                    aria-label="Exemplo de decisão no Jurimetria"
                >
                    <dl class="flex flex-wrap gap-2 gap-x-7 mb-5 pb-4 border-b border-borda text-sm m-0">
                        <div>
                            <dt class="text-tinta-suave text-xs">Tribunal</dt>
                            <dd class="m-0 font-semibold tabular-nums">STJ</dd>
                        </div>
                        <div>
                            <dt class="text-tinta-suave text-xs">Classe</dt>
                            <dd class="m-0 font-semibold tabular-nums">
                                {exemplo.favoravel.classe}{' '}
                                {exemplo.favoravel.numero}
                            </dd>
                        </div>
                        <div>
                            <dt class="text-tinta-suave text-xs">Publicação</dt>
                            <dd class="m-0 font-semibold tabular-nums">
                                {exemplo.favoravel.data}
                            </dd>
                        </div>
                    </dl>

                    <blockquote class="m-0 mb-5 p-0 font-titulo text-xl leading-relaxed">
                        <p
                            class="m-0"
                            set:html={exemplo.favoravel.trecho.replace(
                                exemplo.favoravel.trechoDestaque,
                                `<mark class="bg-mostarda text-inherit px-[0.15em] [box-decoration-break:clone]">${exemplo.favoravel.trechoDestaque}</mark>`,
                            )}
                        />
                    </blockquote>

                    <div class="flex flex-wrap justify-between gap-x-4 gap-y-2 text-sm">
                        <a
                            href={exemplo.favoravel.link}
                            target="_blank"
                            rel="noopener"
                            class="text-verde font-semibold underline underline-offset-4 decoration-1"
                        >
                            Abrir no site do tribunal
                        </a>
                        <span class="text-tinta-suave italic text-xs">
                            Exemplo com dados reais
                        </span>
                    </div>
                </figure>

                    <figure
                        id="painel-jurimetria"
                        role="tabpanel"
                        aria-labelledby="tab-jurimetria"
                        class="m-0 bg-white border border-borda rounded-lg p-6 pb-5 shadow-2xl shadow-tinta/10"
                        aria-label="Taxa de decisões favoráveis por relator"
                    >
                        <figcaption class="mb-4 pb-3 border-b border-borda">
                            <p class="font-titulo text-xl font-semibold m-0">
                                Decisões favoráveis por relator
                            </p>
                            <p class="text-sm text-tinta-suave m-0">
                                {relatores.recorte.tribunal} ·{' '}
                                {relatores.recorte.classe} ·{' '}
                                {relatores.recorte.materia} ·{' '}
                                {relatores.recorte.periodo}
                            </p>
                        </figcaption>

                        <ul class="list-none p-0 m-0 grid gap-3.5">
                            {barras.slice(0, 3).map((b) => (
                                <li class="grid grid-cols-[7.5rem_1fr_3rem] items-center gap-3 text-sm">
                                    <span class="font-medium truncate">
                                        {b.rotulo}
                                    </span>
                                    <span class="block h-3 bg-papel-escuro rounded-sm overflow-hidden">
                                        <span
                                            class="barra block h-full bg-verde rounded-sm"
                                            style={`--w:${b.pct ?? 0}%`}
                                        />
                                    </span>
                                    <span class="font-semibold tabular-nums text-right">
                                        {b.pct === null ? 'base pequena' : `${b.pct}%`}
                                    </span>
                                </li>
                            ))}
                        </ul>

                        <p class="mt-4 text-xs text-tinta-suave m-0">
                            Critério: {relatores.criterio} Base:{' '}
                            {relatores.recorte.minimoDecisoes}+ decisões por
                            relator.
                        </p>
                        <p class="mt-3 mb-0 text-sm">
                            <a
                                href="#jurimetria"
                                class="text-verde font-semibold underline underline-offset-4 decoration-1"
                            >
                                Ver todos os relatores
                            </a>
                        </p>
                    </figure>
                </div>
            </div>
        </section>

        {/* Base — faixa única */}
        <section class="bg-tinta text-papel py-12 border-t-4 border-ouro" aria-label="Sobre a base">
            <div class="container-site">
                <p class="font-titulo text-2xl md:text-3xl leading-tight m-0 text-papel">
                    <strong class="font-bold">{total} decisões</strong>{' '}
                    do {listaTribunais}, de {de} a {ate}.
                </p>
                <p class="mt-3 text-sm text-papel/70 max-w-3xl m-0">
                    {universo.criterio}
                </p>

                <ul
                    class="garantias list-none p-0 mt-8 pt-6 border-t border-papel/20 grid grid-cols-1 md:grid-cols-3 gap-6 m-0"
                    data-garantias
                >
                    {selos.map((s) => (
                        <li>
                            <p class="m-0 flex items-baseline gap-2 text-papel">
                                <span class="numero-grande text-ouro-claro">
                                    <span data-contar={s.pct}>{s.pct}</span>%
                                </span>
                            </p>
                            <span class="trilho" aria-hidden="true">
                                <span class="medida" style={`--w:${s.pct}%`}></span>
                            </span>
                            <p class="m-0 mt-2 text-sm font-medium text-papel">
                                {s.texto}
                            </p>
                        </li>
                    ))}
                </ul>
                <p class="mt-5 text-xs text-papel/60 m-0">
                    Regras do produto, aplicadas a todo resultado exibido.
                </p>
            </div>
        </section>

        {/* Problema */}
        <section class="py-14 md:py-20">
            <div class="container-site">
                <h2 class="font-titulo text-3xl md:text-4xl font-semibold leading-tight mb-4 max-w-3xl">
                    Um precedente errado pode custar o caso.
                </h2>
                <p class="text-lg max-w-xl mb-10 text-tinta-suave">
                    Pesquisa manual deixa lacunas. Estas são as três mais
                    comuns.
                </p>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
                    {dores.map((dor) => (
                        <article class="border-t-2 border-tinta pt-4">
                            <h3 class="font-titulo text-xl font-semibold leading-tight mb-2">
                                {dor.titulo}
                            </h3>
                            <p class="max-w-md text-base m-0">{dor.texto}</p>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        {/* Jurimetria — dados reais */}
        <section id="jurimetria" class="bg-white border-y border-borda py-14 md:py-20">
            <div class="container-site grid grid-cols-1 md:grid-cols-12 gap-14 items-center">
                <div class="md:col-span-5">
                    <h2 class="font-titulo text-3xl md:text-4xl font-semibold leading-tight mb-5">
                        Troque o palpite pelo número.
                    </h2>
                    <p class="max-w-md mb-4">
                        Veja a taxa de decisões favoráveis por classe, matéria,
                        relator e ano.
                    </p>
                    <p class="max-w-md mb-8">
                        Veja como casos parecidos foram decididos. Mostre ao cliente o que os
                        tribunais já decidiram.
                    </p>
                    <a href="/pedir-acesso" class="botao botao-primario">
                        Pedir acesso
                    </a>
                </div>

                <figure
                    class="md:col-span-7 m-0 bg-papel border border-borda rounded-lg p-6 shadow-2xl shadow-tinta/10"
                    aria-label="Taxa de decisões favoráveis por relator"
                >
                    <figcaption class="mb-5 pb-4 border-b border-borda">
                        <p class="font-titulo text-xl font-semibold m-0">
                            Decisões favoráveis por relator
                        </p>
                        <p class="text-sm text-tinta-suave m-0">
                            {relatores.recorte.tribunal} ·{' '}
                            {relatores.recorte.classe} ·{' '}
                            {relatores.recorte.materia} ·{' '}
                            {relatores.recorte.periodo}
                        </p>
                    </figcaption>

                    <ul class="list-none p-0 m-0 grid gap-4">
                        {barras.map((b) => (
                            <li class="grid grid-cols-[10rem_1fr_3rem] items-center gap-4 text-sm">
                                <span class="font-medium truncate">
                                    {b.rotulo}
                                </span>
                                <span class="block h-3 bg-papel-escuro rounded-sm overflow-hidden">
                                    <span
                                        class="barra block h-full bg-verde rounded-sm"
                                        style={`--w:${b.pct ?? 0}%`}
                                    />
                                </span>
                                <span class="font-semibold tabular-nums text-right">
                                    {b.pct === null ? "base pequena" : `${b.pct}%`}
                                </span>
                            </li>
                        ))}
                    </ul>

                    <p class="mt-5 text-sm text-tinta-suave m-0">
                        Critério: {relatores.criterio} Base:{' '}
                        {relatores.recorte.minimoDecisoes}+ decisões por
                        relator.
                    </p>
                </figure>
            </div>
        </section>

        {/* Funções */}
        <section class="py-14 md:py-20">
            <div class="container-site">
                <h2 class="font-titulo text-3xl md:text-4xl font-semibold leading-tight mb-10">
                    O que o Jurimetria faz
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-6 gap-10 mt-10">
                    {funcoes.map((funcao, i) => (
                        <article
                            class:list={[
                                'border-t-2 border-tinta pt-4',
                                i < 2 ? 'md:col-span-3' : 'md:col-span-2',
                            ]}
                        >
                            {funcao.imagem ? (
                                <img
                                    src={funcao.imagem}
                                    alt={`Tela do Jurimetria: ${funcao.titulo}`}
                                    loading="lazy"
                                    width="800"
                                    height="450"
                                    class="block w-full h-auto border border-borda rounded-md mb-4"
                                />
                            ) : (
                                <div
                                    class="flex items-center justify-center aspect-video bg-papel-escuro border border-dashed border-borda rounded-md mb-4 p-4 text-center"
                                    role="img"
                                    aria-label={`Espaço reservado para a captura de ${funcao.titulo}`}
                                >
                                    <span class="text-sm text-tinta-suave italic tracking-wide">
                                        Captura: {funcao.titulo}
                                    </span>
                                </div>
                            )}
                            <h3 class="font-titulo text-xl font-semibold leading-tight mb-2">
                                {funcao.titulo}
                            </h3>
                            <p class="max-w-md text-base m-0">
                                {funcao.resumo}
                            </p>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        {/* Como funciona */}
        <section class="bg-tinta text-papel py-14 md:py-20 border-y-4 border-ouro">
            <div class="container-site">
                <h2 class="font-titulo text-3xl md:text-4xl font-semibold leading-tight mb-12 text-papel">
                    Do caso ao precedente em três passos.
                </h2>

                <ol class="list-none p-0 m-0 grid grid-cols-1 md:grid-cols-3 gap-10">
                    {passos.map((p, i) => (
                        <li class="border-t border-papel/30 pt-4">
                            <span class="font-titulo text-3xl font-bold text-ouro-claro tabular-nums">
                                {i + 1}
                            </span>
                            <h3 class="font-titulo text-xl font-semibold leading-tight mt-2 mb-2 text-papel">
                                {p.titulo}
                            </h3>
                            <p class="max-w-sm text-base m-0 text-papel/85">
                                {p.texto}
                            </p>
                        </li>
                    ))}
                </ol>
            </div>
        </section>

        {/* Confiança */}
        <section class="py-14 md:py-20">
            <div class="container-site">
                <h2 class="font-titulo text-3xl md:text-4xl font-semibold leading-tight mb-4 max-w-3xl">
                    Você confere tudo. Sempre.
                </h2>
                <p class="text-lg max-w-xl mb-10 text-tinta-suave">
                    IA em direito exige prova. Aqui cada resultado traz a sua.
                </p>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
                    {garantias.map((g) => (
                        <article class="border-t-2 border-verde pt-4">
                            <h3 class="font-titulo text-xl font-semibold leading-tight mb-2">
                                {g.titulo}
                            </h3>
                            <p class="max-w-md text-base m-0">{g.texto}</p>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        {/* Fecho */}
        <section class="pt-14 pb-14 md:pt-18 md:pb-22 border-t border-borda">
            <div class="container-site grid grid-cols-1 md:grid-cols-12 gap-12 items-start">
                <div class="md:col-span-8">
                    <h2 class="font-titulo text-3xl md:text-4xl font-semibold leading-tight mb-5">
                        Peça acesso e veja como o STJ e o STF decidem.
                    </h2>
                    <p class="text-lg max-w-xl mb-9 m-0">
                        Nada é inventado pela IA. Tudo vem da base, com link
                        oficial. O advogado decide com as decisões, a taxa e a
                        fonte na mão.
                    </p>
                    <div class="flex flex-wrap items-center gap-6">
                        <a href="/pedir-acesso" class="botao botao-primario">
                            Pedir acesso
                        </a>
                    </div>
                </div>

                <div class="md:col-span-4">
                    <h3 class="font-titulo text-xl font-semibold mb-3">
                        O que ele não faz
                    </h3>
                    <ul class="list-none p-0 m-0">
                        {limites.map((item) => (
                            <li class="py-3 border-t border-borda last:border-b">
                                {item}
                            </li>
                        ))}
                    </ul>
                </div>
            </div>
        </section>
    </div>
</Layout>

<style>
    .barra {
        width: var(--w);
        animation: crescer 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    @keyframes crescer {
        from {
            width: 0;
        }
        to {
            width: var(--w);
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .barra {
            animation: none;
        }
    }

    /* ===== Barras de garantia: crescem quando entram na tela ===== */
    .trilho {
        display: block;
        height: 0.5rem;
        margin-top: 0.6rem;
        background: rgba(238, 242, 240, 0.15);
        border-radius: 999px;
        overflow: hidden;
    }
    .medida {
        display: block;
        height: 100%;
        width: var(--w);
        border-radius: 999px;
        background: linear-gradient(90deg, var(--color-ouro), var(--color-ouro-claro));
    }
    .garantias.anima .medida {
        width: 0;
        transition: width 1.6s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .garantias.anima.visivel .medida {
        width: var(--w);
    }
    @media (prefers-reduced-motion: reduce) {
        .garantias.anima .medida {
            width: var(--w);
            transition: none;
        }
    }

    /* ===== Abas do hero ===== */
    .hero-tab {
        font: inherit;
        font-size: 0.875rem;
        font-weight: 500;
        padding: 0.4rem 0.95rem;
        border-radius: 999px;
        border: 1px solid var(--color-borda);
        background: #ffffff;
        color: var(--color-tinta-suave);
        cursor: pointer;
        transition: background-color 0.15s, color 0.15s;
    }
    .hero-tab:hover {
        color: var(--color-tinta);
        border-color: var(--color-tinta-suave);
    }
    .hero-tab[aria-selected='true'] {
        background: var(--color-tinta);
        border-color: var(--color-tinta);
        color: var(--color-papel);
        box-shadow: inset 0 -2px 0 var(--color-ouro);
    }
    .hero-tab:focus-visible {
        outline: 3px solid var(--color-ouro);
        outline-offset: 2px;
    }
</style>

<script>
    const lista = document.querySelector<HTMLElement>('[data-garantias]');
    if (lista) {
        const reduzido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduzido) {
            lista.classList.add('anima');
            const numeros = lista.querySelectorAll<HTMLElement>('[data-contar]');
            numeros.forEach((n) => (n.textContent = '0'));

            const iniciar = () => {
                lista.classList.add('visivel');
                const duracao = 1600;
                const t0 = performance.now();
                const passo = (agora: number) => {
                    const p = Math.min((agora - t0) / duracao, 1);
                    const ease = 1 - Math.pow(1 - p, 3);
                    numeros.forEach((n) => {
                        n.textContent = String(Math.round(Number(n.dataset.contar) * ease));
                    });
                    if (p < 1) requestAnimationFrame(passo);
                };
                requestAnimationFrame(passo);
            };

            const obs = new IntersectionObserver(
                (entradas) => {
                    if (entradas.some((e) => e.isIntersecting)) {
                        obs.disconnect();
                        iniciar();
                    }
                },
                { threshold: 0.4 },
            );
            obs.observe(lista);
        }
    }
</script>

<script>
    const abas = document.querySelector<HTMLElement>('[data-hero-tabs]');
    if (abas) {
        const botoes = Array.from(
            abas.querySelectorAll<HTMLButtonElement>('[role=tab]'),
        );
        const selecionar = (alvo: HTMLButtonElement, foco = false) => {
            botoes.forEach((b) => {
                const ativo = b === alvo;
                b.setAttribute('aria-selected', String(ativo));
                b.tabIndex = ativo ? 0 : -1;
                const painel = document.getElementById(
                    b.getAttribute('aria-controls') ?? '',
                );
                if (painel) painel.hidden = !ativo;
            });
            if (foco) alvo.focus();
        };
        botoes.forEach((b, i) => {
            b.addEventListener('click', () => selecionar(b));
            b.addEventListener('keydown', (e) => {
                if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
                    e.preventDefault();
                    const passo = e.key === 'ArrowRight' ? 1 : -1;
                    selecionar(
                        botoes[(i + passo + botoes.length) % botoes.length],
                        true,
                    );
                }
            });
        });
    }
</script>
