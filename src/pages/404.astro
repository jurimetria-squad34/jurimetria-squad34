---
import Layout from '../layouts/Layout.astro';
---

<Layout
    title="Página não encontrada — Jurimetria"
    description="A página que você procura não existe ou mudou de endereço."
>
    <div class="bg-papel text-tinta font-corpo">
        <section class="container-site py-24">
            <h1 class="font-titulo text-4xl md:text-5xl font-bold mb-6">
                Página não encontrada.
            </h1>
            <p class="text-lg max-w-xl mb-8 text-tinta-suave">
                O endereço não existe ou mudou. Volte ao início ou veja como o
                Jurimetria funciona.
            </p>
            <div class="flex flex-wrap gap-6">
                <a href="/" class="botao botao-primario">Ir para o início</a>
                <a href="/como-funciona" class="botao botao-secundario">
                    Como funciona
                </a>
            </div>
        </section>
    </div>
</Layout>
